  portraitImage: {fileID: 1404233679689594285}
  collectorPortrait: {fileID: 21300000, guid: 913f2e266c0371b489f2f0ca408b6a1a, type: 3}
  collectorNameText: {fileID: 1821078040850362197}
  dialogueText: {fileID: 4917941285597077794}
  debtAmountText: {fileID: 6802574673279991781}
  minPaymentText: {fileID: 5808154522205110273}
  yourMoneyText: {fileID: 7711177028793433276}
  lateFeeWarningText: {fileID: 8857656670637574085}
  payMinimumBtn: {fileID: 1120852289720437776}
  payAllBtn: {fileID: 4819394949193313464}
  payCustomBtn: {fileID: 6348247493738549919}
  refuseBtn: {fileID: 2113190848311544124}
  customAmountInput: {fileID: 7451124249010095572}
  confirmCustomBtn: {fileID: 7441833634603028052}
  cancelCustomBtn: {fileID: 2776959602102943474}
  resultPanel: {fileID: 4046751969527345720}
  resultText: {fileID: 4251546501285436308}
  resultOkBtn: {fileID: 6961543164991441520}
  collectorName: "\u0E17\u0E32\u0E19\u0E39\u0E01\u0E34"
  typeSpeed: 0.03
  arrivalLine: "\u0E16\u0E36\u0E07\u0E40\u0E27\u0E25\u0E32\u0E08\u0E48\u0E32\u0E22\u0E2B\u0E19\u0E35\u0E49\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30!
    \u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E35\u0E49\u0E44\u0E21\u0E48\u0E0A\u0E2D\u0E1A\u0E23\u0E2D\u0E2B\u0E23\u0E2D\u0E01\u0E19\u0E30..."
  paidFullLine: "\u0E14\u0E35\u0E21\u0E32\u0E01! \u0E40\u0E08\u0E49\u0E32\u0E08\u0E48\u0E32\u0E22\u0E04\u0E23\u0E1A
    \u0E02\u0E49\u0E32\u0E1E\u0E2D\u0E43\u0E08 \u0E44\u0E27\u0E49\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19!"
  paidPartialLine: "\u0E2D\u0E37\u0E21... \u0E08\u0E48\u0E32\u0E22\u0E44\u0E21\u0E48\u0E16\u0E36\u0E07\u0E02\u0E31\u0E49\u0E19\u0E15\u0E48\u0E33\u0E19\u0E30
    \u0E40\u0E2A\u0E35\u0E22\u0E04\u0E48\u0E32\u0E1B\u0E23\u0E31\u0E1A\u0E14\u0E49\u0E27\u0E22!"
  refusedLine: "\u0E44\u0E21\u0E48\u0E08\u0E48\u0E32\u0E22\u0E40\u0E2B\u0E23\u0E2D!?
    \u0E42\u0E14\u0E19\u0E04\u0E48\u0E32\u0E1B\u0E23\u0E31\u0E1A\u0E41\u0E19\u0E48\u0E46
    \u0E40\u0E14\u0E37\u0E2D\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E15\u0E31\u0E27\u0E44\u0E27\u0E49!"
  debtClearedLine: "\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E40\u0E0A\u0E37\u0E48\u0E2D!!
    \u0E40\u0E08\u0E49\u0E32\u0E08\u0E48\u0E32\u0E22\u0E2B\u0E19\u0E35\u0E49\u0E2B\u0E21\u0E14\u0E41\u0E25\u0E49\u0E27!
    \u0E2D\u0E34\u0E2A\u0E23\u0E30\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30!"
